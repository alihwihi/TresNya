{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/index?route=auth/:action"
    },
    {
      "source": "/api/activity/:path*",
      "destination": "/api/index?route=activity/:path*"
    },
    { "source": "/api/jobs/push", "destination": "/api/index?route=jobs/push" }
  ]
}
