{
  "name": "tresnya",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web && node scripts/prepare-web.cjs",
    "preview": "node server/main.cjs",
    "format": "prettier --write App.tsx index.ts src scripts app.json tsconfig.json package.json README.md",
    "server": "node server/main.cjs",
    "android:dev": "expo start --dev-client",
    "check:native": "node scripts/native-location-check.cjs",
    "build:android:preview": "npx --yes eas-cli@latest build --platform android --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vercel/functions": "^3.9.11",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.1.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  }
}
