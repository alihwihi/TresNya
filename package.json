{
  "name": "tresnya",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web && node scripts/prepare-web.cjs",
    "preview": "node server/main.cjs",
    "format": "prettier --write App.tsx index.ts src scripts app.json tsconfig.json package.json README.md",
    "server": "node server/main.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@vercel/functions": "^3.9.11",
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.8",
    "expo-status-bar": "~3.0.8",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/react": "~19.1.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  }
}
