{
  "expo": {
    "name": "TresNya",
    "slug": "tresnya",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "name": "TresNya — Alih & Nana",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto untuk cerita kecil kalian.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "androidMapsConfigured": false,
      "eas": {
        "projectId": "05ed994e-7480-4ca0-ac80-f52ba0bf9b62"
      }
    },
    "owner": "alihdrajat"
  }
}
